@startuml c4-despliegue-seniorcarehub
' =====================================================================
' SeniorCareHub - Vista de despliegue
' PSWE-04 - Avance 3 (S14)
' Render: PlantUML + extension C4-PlantUML (se incluye de forma remota)
' =====================================================================
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

title Vista de despliegue: SeniorCareHub sobre Microsoft Azure

' ---------------------- Fuera de la nube ----------------------
Deployment_Node(cliente, "Dispositivo del usuario", "Navegador web") {
    Container(webapp, "App Web (dashboard)", "SPA React + TypeScript", "Se ejecuta en el navegador del familiar, cuidador, administrador o adulto mayor.")
}

Deployment_Node(simulacion, "Estacion de simulacion", "Contenedor Docker · .NET") {
    Container_Ext(sim, "Simulador de wearable", "Aplicacion .NET", "Emite eventos de movimiento, inactividad y ubicacion.")
}

' ---------------------- Azure ----------------------
Deployment_Node(azure, "Microsoft Azure", "Region East US 2") {
    Deployment_Node(rg, "rg-seniorcarehub", "Grupo de recursos") {

        Deployment_Node(swa, "Azure Static Web Apps", "Nivel Free") {
            Container(estaticos, "Distribucion de la App Web", "Archivos estaticos + TLS gestionado", "Sirve la SPA al navegador del usuario.")
        }

        Deployment_Node(plan, "App Service Plan Linux", "B1 · 1 vCPU · 1.75 GB") {
            Container(api, "API de Aplicacion", "ASP.NET Core Web API", "Autenticacion, autorizacion por rol, consultas y configuracion.")
            Container(ingesta, "Servicio de Ingesta", "ASP.NET Core", "Autentica el dispositivo, valida el evento y lo publica en el bus.")
        }

        Deployment_Node(aca, "Entorno de Azure Container Apps", "Consumo · minimo 1 replica por aplicacion") {
            Container(reglas, "Motor de Reglas", ".NET Worker Service", "Evalua reglas, ventana de confirmacion y deduplicacion.")
            Container(notificaciones, "Servicio de Notificaciones", ".NET Worker Service", "Resuelve canales, invoca proveedores y registra acuses.")
        }

        Deployment_Node(sbns, "Azure Service Bus", "Namespace tier Standard") {
            ContainerQueue(bus, "Bus de Mensajeria", "Topics + subscriptions", "Transporte durable con DLQ, sesiones y deteccion de duplicados.")
        }

        Deployment_Node(pgsrv, "PostgreSQL Flexible Server", "B1ms · 32 GB") {
            ContainerDb(bdop, "BD Operativa", "PostgreSQL", "Usuarios, perfiles, reglas, alertas y acuses.")
            ContainerDb(bdev, "Almacen de Eventos", "PostgreSQL particionado", "Historial de eventos del wearable.")
        }

        Deployment_Node(kv, "Azure Key Vault", "Estandar") {
            Container(secretos, "Almacen de secretos", "Key Vault", "Cadenas de conexion y credenciales de proveedores externos.")
        }

        Deployment_Node(obs, "Observabilidad", "Application Insights + Log Analytics") {
            Container(telemetria, "Telemetria correlacionada", "Application Insights", "Trazas, metricas y registros de los cuatro servicios.")
        }
    }
}

' ---------------------- Externos ----------------------
System_Ext(notif, "Servicios de notificacion externos", "Proveedores de correo, SMS y mensajeria.")

' ---------------------- Relaciones ----------------------
Rel(webapp, estaticos, "Descarga la aplicacion", "HTTPS")
Rel(webapp, api, "Consulta y configura", "HTTPS/JSON")
Rel(sim, ingesta, "Emite eventos", "HTTPS/TLS")

Rel(ingesta, bus, "Publica evento crudo", "AMQP 1.0")
Rel(bus, reglas, "Entrega evento crudo", "AMQP 1.0")
Rel(reglas, bus, "Publica alerta confirmada", "AMQP 1.0")
Rel(bus, notificaciones, "Entrega alerta confirmada", "AMQP 1.0")
Rel(notificaciones, notif, "Envia la notificacion", "HTTPS/REST y SMTP")

Rel(api, bdop, "Lee y escribe", "SQL/TLS")
Rel(reglas, bdop, "Lee reglas y escribe alertas", "SQL/TLS")
Rel(notificaciones, bdop, "Registra acuses", "SQL/TLS")
Rel(ingesta, bdev, "Persiste el evento", "SQL/TLS")
Rel(api, bdev, "Consulta el historial", "SQL/TLS")

Rel(api, telemetria, "Emite trazas", "HTTPS")
Rel(ingesta, telemetria, "Emite trazas", "HTTPS")
Rel(reglas, telemetria, "Emite trazas", "HTTPS")
Rel(notificaciones, telemetria, "Emite trazas", "HTTPS")

Rel(api, secretos, "Obtiene secretos", "HTTPS · identidad administrada")
Rel(ingesta, secretos, "Obtiene secretos", "HTTPS · identidad administrada")
Rel(reglas, secretos, "Obtiene secretos", "HTTPS · identidad administrada")
Rel(notificaciones, secretos, "Obtiene secretos", "HTTPS · identidad administrada")

SHOW_LEGEND()
@enduml
