sequenceDiagram
    autonumber

    participant Bus as Bus de Mensajería
    participant Consumer as AlertMessageConsumer
    participant Service as NotificationProcessingService
    participant ProfileRepo as INotificationProfileRepository
    participant TrackingRepo as INotificationTrackingRepository
    participant ChannelService as ChannelSelectionService
    participant Resolver as DeliveryPolicyResolver
    participant Strategy as ParallelDeliveryStrategy
    participant Factory as NotificationAdapterFactory
    participant Adapter as INotificationAdapter
    participant Provider as Proveedor externo

    Bus->>Consumer: Entregar mensaje de alerta confirmada
    activate Consumer

    Consumer->>Consumer: MapToAlert(message)
    Consumer->>Service: ProcessAsync(alert)
    activate Service

    Service->>ProfileRepo: GetByOlderAdultIdAsync(alert.olderAdultId, alert.profileVersion)
    activate ProfileRepo
    ProfileRepo-->>Service: NotificationProfile
    deactivate ProfileRepo

    loop Por cada destinatario habilitado del perfil
        Service->>TrackingRepo: GetByAlertAndRecipientAsync(alert.alertId, recipient.recipientId)
        activate TrackingRepo
        TrackingRepo-->>Service: null
        deactivate TrackingRepo

        Note over Service: No existe una notificación previa.<br/>Se crea Notification para el destinatario.

        Service->>Service: CreateNotification(alert, recipient)
        Service->>Service: notification.MarkInProgress()

        Service->>TrackingRepo: SaveNotificationAsync(notification)
        activate TrackingRepo
        TrackingRepo-->>Service: Notification almacenada
        deactivate TrackingRepo

        Service->>ChannelService: SelectApplicableChannels(alert, profile, recipient)
        activate ChannelService
        ChannelService-->>Service: NotificationChannelCollection
        deactivate ChannelService

        Service->>Resolver: ResolveStrategy(alert, profile)
        activate Resolver

        Note over Resolver: La severidad Critical requiere<br/>una política de entrega Parallel.

        Resolver-->>Service: ParallelDeliveryStrategy
        deactivate Resolver

        Service->>Strategy: ExecuteAsync(alert, recipient, channels)
        activate Strategy

        par Por cada canal aplicable
            Strategy->>Factory: Create(channelType, providerId)
            activate Factory
            Factory->>Adapter: Supports(channelType, providerId)
            activate Adapter
            Adapter-->>Factory: true
            deactivate Adapter
            Factory-->>Strategy: INotificationAdapter compatible
            deactivate Factory

            Strategy->>Adapter: SendAsync(alert, recipient, channel)
            activate Adapter
            Adapter->>Provider: Solicitar envío de la notificación
            activate Provider
            Provider-->>Adapter: Solicitud aceptada
            deactivate Provider
            Adapter-->>Strategy: AdapterSendResult<br/>DeliveryStatus = Accepted
            deactivate Adapter
        and Otros canales aplicables
            Note over Strategy,Provider: Los demás canales configurados se procesan<br/>de forma concurrente siguiendo la misma secuencia.
        end

        Strategy-->>Service: ChannelDeliveryResultCollection
        deactivate Strategy

        loop Por cada resultado de entrega
            Service->>Service: CreateAttempt(notification, result)

            Service->>TrackingRepo: SaveAttemptAsync(attempt)
            activate TrackingRepo
            TrackingRepo-->>Service: Intento registrado
            deactivate TrackingRepo
        end

        Note over Service: Al menos un proveedor aceptó<br/>la solicitud de entrega.

        Service->>Service: notification.MarkDelivered()

        Service->>TrackingRepo: SaveNotificationAsync(notification)
        activate TrackingRepo
        TrackingRepo-->>Service: Estado Delivered almacenado
        deactivate TrackingRepo
    end

    Service-->>Consumer: NotificationProcessingResult<br/>Status = Delivered<br/>ShouldAcknowledgeMessage = true
    deactivate Service

    Consumer->>Bus: Confirmar mensaje (ACK)

    deactivate Consumer